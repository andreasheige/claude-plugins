{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/andreasheige/claude-plugins/skills/skills/prototype-to-backlog/references/backlog.schema.json",
  "title": "prototype-to-backlog backlog",
  "description": "One backlog per run. scripts/backlog.py validates the same rules with the standard library only.",
  "type": "object",
  "required": ["version", "project", "items"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "project": { "type": "string", "minLength": 1, "description": "Names the state folder ~/.prototype-to-backlog/<slug>." },
    "language": { "type": "string", "description": "Language the stories are written in, e.g. sv or en." },
    "source": {
      "type": "object",
      "properties": {
        "prototype": { "type": "string" },
        "repo": { "type": "string" },
        "inventory": { "type": "string", "description": "Path to inventory.json from scripts/shoot.mjs." }
      }
    },
    "ado": {
      "type": "object",
      "properties": {
        "organization": { "type": "string", "pattern": "^https://" },
        "project": { "type": "string" },
        "team": { "type": "string" },
        "board": { "type": "string", "description": "Board (backlog level) name, default Stories." },
        "area": { "type": "string" },
        "iteration": { "type": "string" },
        "assignedTo": { "type": "string" }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/item" }
    },
    "approvals": {
      "type": "array",
      "description": "Append-only log, one entry per approval run. Written by backlog.py approve.",
      "items": {
        "type": "object",
        "required": ["at", "by", "scope", "ids"],
        "properties": {
          "at": { "type": "string" },
          "by": { "type": "string" },
          "scope": { "enum": ["all", "ids"] },
          "ids": { "type": "array", "items": { "type": "string" } },
          "note": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "ref": {
      "description": "Another item's key, or an existing ADO work item as \"#12345\".",
      "type": "string",
      "pattern": "^(#[0-9]+|[A-Za-z][A-Za-z0-9_.-]*)$"
    },
    "criterion": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "required": ["given", "when", "then"],
          "additionalProperties": false,
          "properties": {
            "given": { "type": "string", "minLength": 1 },
            "when": { "type": "string", "minLength": 1 },
            "then": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "item": {
      "type": "object",
      "required": ["key", "type", "title"],
      "additionalProperties": false,
      "properties": {
        "key": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$", "description": "Stable for the life of the backlog; the idempotency key is derived from project + key." },
        "type": { "enum": ["Epic", "Feature", "User Story", "Task", "Bug"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 255 },
        "description": { "type": "string", "description": "Plain text; blank lines split paragraphs, lines starting with '- ' become a list." },
        "acceptanceCriteria": { "type": "array", "items": { "$ref": "#/$defs/criterion" } },
        "parent": { "$ref": "#/$defs/ref" },
        "dependsOn": { "type": "array", "items": { "$ref": "#/$defs/ref" }, "description": "Each entry becomes this item's predecessor." },
        "related": { "type": "array", "items": { "$ref": "#/$defs/ref" } },
        "screenshots": { "type": "array", "items": { "type": "string" } },
        "tags": { "type": "array", "items": { "type": "string", "pattern": "^[^;]+$" } },
        "state": { "type": "string", "not": { "enum": ["Closed", "Removed", "Done"] } },
        "column": { "type": "string" },
        "assignedTo": { "type": "string" },
        "area": { "type": "string" },
        "iteration": { "type": "string" },
        "storyPoints": { "type": "number", "minimum": 0 },
        "refinement": {
          "type": "object",
          "properties": {
            "status": { "enum": ["draft", "ready", "refined", "needs-human"] },
            "rounds": { "type": "integer", "minimum": 0, "maximum": 2 },
            "verdicts": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["persona", "verdict"],
                "properties": {
                  "persona": { "type": "string" },
                  "round": { "type": "integer" },
                  "verdict": { "enum": ["pass", "fix"] },
                  "notes": { "type": "string" }
                }
              }
            }
          }
        },
        "approval": {
          "type": "object",
          "required": ["at", "hash"],
          "description": "Set by backlog.py approve. hash covers the published fields; an edit after approval voids it.",
          "properties": {
            "at": { "type": "string" },
            "by": { "type": "string" },
            "hash": { "type": "string", "pattern": "^[0-9a-f]{16}$" }
          }
        }
      }
    }
  }
}
